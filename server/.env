# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/jiomart_clone
MONGODB_URI_TEST=mongodb://localhost:27017/jiomart_clone_test

# JWT Configuration
JWT_SECRET=jiomart_super_secret_jwt_key_development_only_2024
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=demo_api_key
CLOUDINARY_API_SECRET=demo_api_secret

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=demo@gmail.com
EMAIL_PASSWORD=demo_password

# Payment Gateway Configuration
STRIPE_SECRET_KEY=sk_test_demo_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_demo_stripe_key

RAZORPAY_KEY_ID=demo_razorpay_id
RAZORPAY_KEY_SECRET=demo_razorpay_secret

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100