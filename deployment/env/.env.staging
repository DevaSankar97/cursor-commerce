# Staging Environment Configuration
NODE_ENV=staging
PORT=5000

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/jiomart_staging?retryWrites=true&w=majority
REDIS_URI=redis://staging-redis.amazonaws.com:6379

# JWT Configuration
JWT_SECRET=your-staging-jwt-secret-key-256-bit
JWT_REFRESH_SECRET=your-staging-refresh-secret-key-256-bit
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-staging-cloud-name
CLOUDINARY_API_KEY=your-staging-api-key
CLOUDINARY_API_SECRET=your-staging-api-secret

# Email Configuration (Staging/Test SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your-mailtrap-username
EMAIL_PASSWORD=your-mailtrap-password
EMAIL_FROM=JioMart Clone Staging <staging@yourcompany.com>

# Payment Gateway Configuration (Test Keys)
STRIPE_SECRET_KEY=sk_test_your-test-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-test-stripe-publishable-key
RAZORPAY_KEY_ID=rzp_test_your-test-razorpay-key-id
RAZORPAY_KEY_SECRET=your-test-razorpay-key-secret

# Frontend Configuration
FRONTEND_URL=https://staging.yourdomain.com
CORS_ORIGIN=https://staging.yourdomain.com

# Rate Limiting Configuration (More lenient for testing)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=jiomart-staging-uploads

# Security Configuration
COOKIE_SECRET=your-staging-cookie-secret
SESSION_SECRET=your-staging-session-secret
BCRYPT_ROUNDS=10

# Monitoring Configuration
SENTRY_DSN=https://your-staging-sentry-dsn@sentry.io/project-id
NEW_RELIC_LICENSE_KEY=your-staging-new-relic-license-key
NEW_RELIC_APP_NAME=JioMart Clone Staging

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE_PATH=/var/log/jiomart/staging-app.log

# Cache Configuration
CACHE_TTL=1800
CACHE_MAX_SIZE=500

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_CHAT_SUPPORT=false
ENABLE_WISHLIST=true
ENABLE_REVIEWS=true