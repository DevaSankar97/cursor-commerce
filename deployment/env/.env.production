# Production Environment Configuration
NODE_ENV=production
PORT=5000

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/jiomart_prod?retryWrites=true&w=majority
REDIS_URI=redis://redis-cluster.amazonaws.com:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-production-256-bit
JWT_REFRESH_SECRET=your-super-secret-refresh-key-production-256-bit
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-production-cloud-name
CLOUDINARY_API_KEY=your-production-api-key
CLOUDINARY_API_SECRET=your-production-api-secret

# Email Configuration (Production SMTP)
EMAIL_HOST=smtp.yourcompany.com
EMAIL_PORT=587
EMAIL_USER=noreply@yourcompany.com
EMAIL_PASSWORD=your-email-app-password
EMAIL_FROM=JioMart Clone <noreply@yourcompany.com>

# Payment Gateway Configuration
STRIPE_SECRET_KEY=sk_live_your-live-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-live-stripe-publishable-key
RAZORPAY_KEY_ID=rzp_live_your-live-razorpay-key-id
RAZORPAY_KEY_SECRET=your-live-razorpay-key-secret

# Frontend Configuration
FRONTEND_URL=https://yourdomain.com
CORS_ORIGIN=https://yourdomain.com

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=jiomart-prod-uploads

# Security Configuration
COOKIE_SECRET=your-super-secret-cookie-key-production
SESSION_SECRET=your-super-secret-session-key-production
BCRYPT_ROUNDS=12

# Monitoring Configuration
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key
NEW_RELIC_APP_NAME=JioMart Clone Production

# SSL Configuration
SSL_CERT_PATH=/etc/ssl/certs/cert.pem
SSL_KEY_PATH=/etc/ssl/private/key.pem

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/jiomart/app.log

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_CHAT_SUPPORT=true
ENABLE_WISHLIST=true
ENABLE_REVIEWS=true